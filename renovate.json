{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Policy: minor and patch updates auto-approve and auto-merge (squash); majors never do.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "autoApprove": true
    },
    {
      "description": "Group minor and patch dependency updates into one pull request",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all minor and patch dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Keep major dependency updates in individual pull requests",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "autoApprove": false
    }
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3d",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "autoApprove": false
}
