{
    "name": "mohemian/flink-sdk-php",
    "description": "Verify FLINK results (ID Austria prefill) in a Laravel backend.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "flink",
        "id-austria",
        "eid",
        "jwt",
        "jwks",
        "laravel"
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.36|^3.8|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Mohemian\\Flink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mohemian\\Flink\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mohemian\\Flink\\FlinkServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
